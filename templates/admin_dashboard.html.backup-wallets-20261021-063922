<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Alixo Earn | Admin Dashboard</title>
<link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
<style>
.admin-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin:24px 0}
.admin-stat,.admin-section{background:#0a1425;border:1px solid #174879;border-radius:15px;padding:18px;margin-bottom:18px}
.admin-stat strong{display:block;font-size:27px;color:#8fe6ff;margin-top:10px}
.admin-section{overflow-x:auto}
.admin-section h2{color:#8fe6ff}
.admin-table{width:100%;border-collapse:collapse;min-width:600px}
.admin-table th,.admin-table td{padding:12px;text-align:left;border-bottom:1px solid #20344c}
.admin-table th{color:#8fe6ff}
.admin-table button,.admin-action{padding:9px 12px;border:1px solid #38baff;border-radius:8px;background:#10264a;color:#8fe6ff;text-decoration:none;cursor:pointer}
.admin-section select,.admin-section input{max-width:100%;padding:10px;border:1px solid #24517b;border-radius:8px;background:#050914;color:white}
.admin-form{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.pending{color:#ffd479}.approved{color:#75f0b2}.rejected{color:#ff9696}
</style>
</head>
<body>
<header class="navbar">
<a href="/" class="logo"><span>A</span>LIXO <b>EARN</b> ADMIN</a>
<form method="POST" action="{{ url_for('admin_logout') }}">
<input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
<button class="nav-button" type="submit">Logout</button>
</form>
</header>
<main class="dashboard-page">
<section class="welcome-panel">
<div class="status">ADMIN CONTROL CENTRE</div>
<h1>Admin <span>Dashboard.</span></h1>
<p>Review requests and manage Alixo Earn accounts.</p>
</section>
{% with messages = get_flashed_messages(with_categories=true) %}
{% for category, message in messages %}
<div class="flash {{ category }}">{{ message }}</div>
{% endfor %}
{% endwith %}
<section class="admin-stats">
<div class="admin-stat">Total Users<strong>{{ total_users }}</strong></div>
<div class="admin-stat">Active Members<strong>{{ active_users }}</strong></div>
<div class="admin-stat">Pending Deposits<strong>{{ pending_deposits }}</strong></div>
<div class="admin-stat">Pending Withdrawals<strong>{{ pending_withdrawals }}</strong></div>
</section>

<section class="admin-section">
<h2>Registered Users</h2>
<table class="admin-table">
<tr><th>ID</th><th>Username</th><th>Phone</th><th>Plan</th><th>Balance</th><th>Activate Plan</th></tr>
{% for u in users %}
<tr>
<td>{{ u.id }}</td><td>{{ u.username }}</td><td>{{ u.phone }}</td><td>{{ u.plan }}</td><td>₦{{ "{:,.0f}".format(u.balance) }}</td>
<td>
<form class="admin-form" method="POST" action="{{ url_for('admin_activate_plan', user_id=u.id) }}">
<input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
<select name="plan">
{% for plan in plans %}
<option value="{{ plan.name }}" {% if u.plan == plan.name %}selected{% endif %}>{{ plan.name }}</option>
{% endfor %}
</select>
<button type="submit">Activate</button>
</form>
</td>
</tr>
{% else %}<tr><td colspan="6">No users registered yet.</td></tr>{% endfor %}
</table>
</section>

<section class="admin-section">
<h2>Deposit Requests</h2>
<table class="admin-table">
<tr><th>ID</th><th>User</th><th>Amount</th><th>Sender</th><th>Status</th><th>Review</th></tr>
{% for d in deposits %}
<tr><td>{{ d.id }}</td><td>{{ d.username }}</td><td>₦{{ "{:,.0f}".format(d.amount) }}</td><td>{{ d.sender_name }}</td><td class="{{ d.status|lower }}">{{ d.status }}</td><td>
{% if d.status == 'Pending' %}
<form class="admin-form" method="POST" action="{{ url_for('admin_review_deposit', deposit_id=d.id) }}">
<input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
<button name="decision" value="Approved">Approve</button><button name="decision" value="Rejected">Reject</button>
</form>
{% else %}Reviewed{% endif %}
</td></tr>
{% else %}<tr><td colspan="6">No deposit requests.</td></tr>{% endfor %}
</table>
<p>Approve a deposit only after verifying that the payment was received.</p>
</section>

<section class="admin-section">
<h2>Withdrawal Requests</h2>
<table class="admin-table">
<tr><th>ID</th><th>User</th><th>Amount</th><th>Bank</th><th>Account</th><th>Status</th><th>Review</th></tr>
{% for w in withdrawals %}
<tr><td>{{ w.id }}</td><td>{{ w.username }}</td><td>₦{{ "{:,.0f}".format(w.amount) }}</td><td>{{ w.bank_name }}</td><td>{{ w.account_number }}</td><td class="{{ w.status|lower }}">{{ w.status }}</td><td>
{% if w.status == 'Pending' %}
<form class="admin-form" method="POST" action="{{ url_for('admin_review_withdrawal', withdrawal_id=w.id) }}">
<input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
<button name="decision" value="Approved">Approve</button><button name="decision" value="Rejected">Reject</button>
</form>
{% else %}Reviewed{% endif %}
</td></tr>
{% else %}<tr><td colspan="7">No withdrawal requests.</td></tr>{% endfor %}
</table>
<p>Verify and process the payout before marking a withdrawal as approved.</p>
</section>

<section class="admin-section task-builder">
<h2>Create a Task</h2>
<p class="task-builder-intro">Publish a clear task with a working link for eligible members.</p>

<form method="POST" action="{{ url_for('admin_create_task') }}" class="task-builder-form">
<input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

<label for="task-title">Task title</label>
<input id="task-title" name="title" placeholder="e.g. Visit our website" required maxlength="100">

<label for="task-instructions">Task instructions</label>
<textarea id="task-instructions" name="instructions" placeholder="Explain exactly what the user must do..." required maxlength="1000" rows="4"></textarea>

<label for="task-link">Task link</label>
<input id="task-link" name="task_link" type="url" placeholder="https://example.com/task" required>

<label for="task-plan">Eligible membership plan</label>
<select id="task-plan" name="plan">
<option value="All" data-reward="200">All plans — ₦200</option>
{% for p in plans %}
<option value="{{ p.name }}" data-reward="{{ p.daily }}">{{ p.name }} — ₦{{ "{:,.0f}".format(p.daily) }}</option>
{% endfor %}
</select>

<div class="task-reward-preview">
<span>Configured task reward</span>
<strong id="task-reward">₦200</strong>
<small>Reward is fixed by the selected plan.</small>
</div>

<button type="submit" class="publish-task-button">PUBLISH TASK <span>↗</span></button>
</form>
</section>

<style>
.task-builder{padding:22px!important;border:1px solid #2476b9!important;background:linear-gradient(145deg,#0c1b31,#07101f)!important;box-shadow:0 0 24px #087bff18}
.task-builder h2{margin-top:0;font-size:clamp(24px,6vw,34px)}
.task-builder-intro{color:#9fb4ce;line-height:1.6}
.task-builder-form{display:grid;gap:10px}
.task-builder-form label{margin-top:8px;color:#bdeeff;font-weight:600;font-size:14px}
.task-builder-form input,.task-builder-form textarea,.task-builder-form select{box-sizing:border-box;width:100%;min-width:0;padding:14px;border:1px solid #28537b;border-radius:12px;background:#050b17;color:#f3f8ff;font:inherit;outline:none}
.task-builder-form input:focus,.task-builder-form textarea:focus,.task-builder-form select:focus{border-color:#38baff;box-shadow:0 0 0 3px #168bff20}
.task-builder-form textarea{resize:vertical}
.task-reward-preview{display:grid;gap:6px;margin-top:8px;padding:16px;border:1px solid #1c679d;border-radius:12px;background:#071a2b}
.task-reward-preview span,.task-reward-preview small{color:#9fb4ce}
.task-reward-preview strong{font-size:28px;color:#8fe6ff}
.publish-task-button{display:flex;align-items:center;justify-content:center;gap:12px;width:100%;min-height:54px;margin-top:8px;padding:15px;border:1px solid #57d7ff;border-radius:13px;background:linear-gradient(105deg,#0877ff,#13bde9);color:white;font-size:15px;font-weight:800;letter-spacing:1px;box-shadow:0 0 20px #087bff55;cursor:pointer}
.publish-task-button:active{transform:scale(.98)}
</style>

<script>
(() => {
    const plan = document.getElementById("task-plan");
    const reward = document.getElementById("task-reward");
    if (!plan || !reward) return;
    function updateReward() {
        const option = plan.options[plan.selectedIndex];
        reward.textContent = "₦" + Number(option.dataset.reward || 0).toLocaleString("en-NG");
    }
    plan.addEventListener("change", updateReward);
    updateReward();
})();
</script>

<section class="admin-section">
<h2>Published Tasks</h2>
<table class="admin-table">
<tr><th>ID</th><th>Title</th><th>Plan</th><th>Reward</th><th>Task Link</th><th>Status</th></tr>
{% for t in tasks %}
<tr><td>{{ t.id }}</td><td>{{ t.title }}</td><td>{{ t.plan }}</td><td>₦{{ "{:,.0f}".format(t.reward) }}</td><td>{% if t.task_link %}<a class="admin-action" href="{{ t.task_link }}" target="_blank" rel="noopener noreferrer">Open ↗</a>{% else %}Not set{% endif %}</td><td>{{ t.status }}</td></tr>
{% else %}<tr><td colspan="6">No tasks published yet.</td></tr>{% endfor %}
</table>
</section>
</main>
</body>
</html>
