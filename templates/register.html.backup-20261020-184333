<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#050914">
<title>Create Account | Alixo Earn</title>
<link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>

<header class="navbar">
    <a href="/" class="logo"><span>A</span>LIXO <b>EARN</b></a>
    <a href="{{ url_for('login') }}" class="nav-button">Login ↗</a>
</header>

<main class="auth-page">
    <section class="auth-card">

        <div class="auth-icon">✦</div>
        <div class="status">JOIN ALIXO EARN</div>

        <h1>Create Your <span>Account.</span></h1>
        <p class="auth-subtitle">
            Start your Alixo Earn journey. Create your account
            with the details below.
        </p>

        {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
        <div class="flash-list">
            {% for category, message in messages %}
            <div class="flash {{ category }}">{{ message }}</div>
            {% endfor %}
        </div>
        {% endif %}
        {% endwith %}

        <form method="POST" action="{{ url_for('register') }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

            <label for="phone">Phone Number</label>
            <input
                id="phone"
                type="tel"
                name="phone"
                placeholder="e.g. 08012345678"
                autocomplete="tel"
                maxlength="16"
                required
            >

            <label for="username">Username</label>
            <input
                id="username"
                type="text"
                name="username"
                placeholder="Choose a username"
                autocomplete="username"
                minlength="3"
                maxlength="24"
                pattern="[A-Za-z0-9_]+"
                required
            >
            <small class="field-help">3–24 letters, numbers or underscores.</small>

            <label for="referral_code">Referral Code <span class="optional">(Optional)</span></label>
            <input
                id="referral_code"
                type="text"
                name="referral_code"
                placeholder="Enter a friend's referral code"
                maxlength="32"
                autocomplete="off"
            >

            <label for="password">Password</label>
            <input
                id="password"
                type="password"
                name="password"
                placeholder="Create a strong password"
                autocomplete="new-password"
                minlength="8"
                maxlength="128"
                required
            >

            <label for="confirm_password">Confirm Password</label>
            <input
                id="confirm_password"
                type="password"
                name="confirm_password"
                placeholder="Enter your password again"
                autocomplete="new-password"
                minlength="8"
                maxlength="128"
                required
            >

            <button class="auth-submit" type="submit">Create My Account →</button>
        </form>

        <div class="auth-switch">
            Already have an account?
            <a href="{{ url_for('login') }}">Login here</a>
        </div>

        <a href="/" class="back-home">← Back to homepage</a>

    </section>
</main>

<footer>
    <a href="/" class="logo"><span>A</span>LIXO <b>EARN</b></a>
    <p>Your digital experience starts here.</p>
    <small>© 2026 Alixo Earn</small>
</footer>

</body>
</html>
