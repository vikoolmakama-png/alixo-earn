<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#050914">
<title>Dashboard | Alixo Earn</title>
<link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>

<header class="navbar">
    <a href="/" class="logo"><span>A</span>LIXO <b>EARN</b></a>
    <form method="POST" action="{{ url_for('logout') }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <button type="submit" class="nav-button logout-button">Logout ↗</button>
    </form>
</header>

<main class="dashboard-page">

    {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
    <div class="flash-list">
        {% for category, message in messages %}
        <div class="flash {{ category }}">{{ message }}</div>
        {% endfor %}
    </div>
    {% endif %}
    {% endwith %}

    <section class="welcome-panel">
        <div class="status"><span class="dot"></span> MEMBER DASHBOARD</div>
        <h1>Welcome back,<br><span>{{ user["username"] }}.</span></h1>
        <p>Manage your membership, tasks, deposits and referrals in one place.</p>
    </section>

    <section class="telegram-channel-card">
        <div class="telegram-channel-icon">✈</div>
        <div class="telegram-channel-content">
            <span class="telegram-channel-label">OFFICIAL COMMUNITY</span>
            <h2>Join Our Telegram Channel</h2>
            <p>Get Alixo Earn announcements, updates and important information directly from our official channel.</p>
            <a href="https://t.me/Updatehub456"
               class="telegram-channel-button"
               target="_blank"
               rel="noopener noreferrer">
                JOIN OFFICIAL TELEGRAM <span>↗</span>
            </a>
        </div>
    </section>

    <section class="dashboard-grid">
        <article class="dashboard-card">
            <div class="feature-icon">₦</div>
            <p>Account Balance</p>
            <h2>₦{{ "{:,.2f}".format(user["balance"]) }}</h2>
            <small>Recorded account balance</small>
        </article>

        <article class="dashboard-card">
            <div class="feature-icon">💎</div>
            <p>Active Plan</p>
            <h2>{{ user["plan"] }}</h2>
            <small>
                {% if user["plan"] == "None" %}
                No plan activated
                {% else %}
                Membership recorded
                {% endif %}
            </small>
        </article>

        <article class="dashboard-card">
            <div class="feature-icon">👥</div>
            <p>Registered Referrals</p>
            <h2>{{ referral_count }}</h2>
            <small>Accounts registered with your code</small>
            <p>Total Referral Rewards</p>
            <h2>₦{{ "{:,.0f}".format(referral_total) }}</h2>
            <small>Earned from qualifying plan activations</small>
        </article>

        <a href="{{ url_for('transaction_history') }}" class="dashboard-card history-dashboard-card">
            <div class="feature-icon">📋</div>
            <p>Transaction History</p>
            <h2>View History</h2>
            <small>Check your deposits and withdrawals</small>
        </a>
    </section>

    <section class="referral-panel" id="referrals">
        <div class="status">YOUR PERSONAL REFERRAL CODE</div>
        <h2>Invite friends to Alixo Earn.</h2>

        <div class="referral-code">ALIXOEARN.{{ request.url_root.rstrip('/') }}{{ url_for('register', ref=user['referral_code']) }}</div>
        <button class="primary-button" id="copyCode" type="button">Copy Referral Code</button>
        <p id="copyMessage" class="copy-message" aria-live="polite"></p>
    </section>


</main>

<footer>
    <a href="/" class="logo"><span>A</span>LIXO <b>EARN</b></a>
    <p>Your digital experience starts here.</p>
    <small>© 2026 Alixo Earn</small>
</footer>

<script>
document.getElementById("copyCode").addEventListener("click", async () => {
    const code = {{ user["referral_code"] | tojson }};
    const message = document.getElementById("copyMessage");
    try {
        await navigator.clipboard.writeText(code);
        message.textContent = "Referral code copied!";
    } catch (error) {
        message.textContent = "Your referral code is: " + code;
    }
});
</script>


<nav class="bottom-nav" aria-label="Main navigation">
    <a href="{{ url_for('dashboard') }}" class="bottom-nav-item active">
        <span class="bottom-nav-icon">⌂</span>
        <span>Home</span>
    </a>
    <a href="{{ url_for('plans_page') }}" class="bottom-nav-item">
        <span class="bottom-nav-icon">💎</span>
        <span>Plans</span>
    </a>
    <a href="{{ url_for('deposit') }}" class="bottom-nav-item nav-feature">
        <span class="bottom-nav-icon">＋</span>
        <span>Deposit</span>
    </a>
    <a href="{{ url_for('withdraw') }}" class="bottom-nav-item">
        <span class="bottom-nav-icon">↗</span>
        <span>Withdraw</span>
    </a>
    <a href="{{ url_for('tasks_page') }}" class="bottom-nav-item">
        <span class="bottom-nav-icon">☰</span>
        <span>Tasks</span>
    </a>
</nav>

</body>
</html>
