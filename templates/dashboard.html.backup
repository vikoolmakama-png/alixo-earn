<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#050914">
<title>My Dashboard | Alixo Earn</title>
<link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>

<header class="navbar">
    <a href="/" class="logo"><span>A</span>LIXO <b>EARN</b></a>
    <form method="POST" action="{{ url_for('logout') }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <button type="submit" class="nav-button logout-button">Logout ↗</button>
    </form>
</header>

<main class="dashboard-page">

    {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
    <div class="flash-list">
        {% for category, message in messages %}
        <div class="flash {{ category }}">{{ message }}</div>
        {% endfor %}
    </div>
    {% endif %}
    {% endwith %}

    <section class="welcome-panel">
        <div class="status"><span class="dot"></span> MEMBER DASHBOARD</div>
        <h1>Welcome back,<br><span>{{ user["username"] }}.</span></h1>
        <p>Your Alixo Earn account overview is ready.</p>
    </section>

    <section class="dashboard-grid">

        <article class="dashboard-card">
            <div class="feature-icon">₦</div>
            <p>Account Balance</p>
            <h2>₦{{ "{:,.2f}".format(user["balance"]) }}</h2>
            <small>Available recorded balance</small>
        </article>

        <article class="dashboard-card">
            <div class="feature-icon">✦</div>
            <p>Membership Plan</p>
            <h2>{{ user["plan"] }}</h2>
            <small>No plan activated yet</small>
        </article>

        <article class="dashboard-card">
            <div class="feature-icon">↗</div>
            <p>Registered Referrals</p>
            <h2>{{ referral_count }}</h2>
            <small>Accounts registered with your code</small>
        </article>

    </section>

    <section class="referral-panel">
        <div class="status">YOUR PERSONAL REFERRAL CODE</div>
        <h2>Invite friends when you're ready.</h2>
        <p>Share your referral code with someone who wants to register.</p>

        <div class="referral-code">{{ user["referral_code"] }}</div>
        <button class="primary-button" id="copyCode" type="button">
            Copy Referral Code
        </button>
        <p id="copyMessage" class="copy-message" aria-live="polite"></p>
    </section>

    <section class="dashboard-info">
        <h2>Your next steps</h2>
        <p>
            Your account has been created successfully. Plan activation,
            task completion, rewards and withdrawals are not enabled yet.
            Your displayed balance is currently zero until a verified
            transaction system is implemented.
        </p>
        <a href="{{ url_for('home') }}" class="plan-button">
            Explore Membership Plans →
        </a>
    </section>

</main>

<footer>
    <a href="/" class="logo"><span>A</span>LIXO <b>EARN</b></a>
    <p>Your digital experience starts here.</p>
    <small>© 2026 Alixo Earn</small>
</footer>

<script>
document.getElementById("copyCode").addEventListener("click", async () => {
    const code = {{ user["referral_code"] | tojson }};
    const message = document.getElementById("copyMessage");

    try {
        await navigator.clipboard.writeText(code);
        message.textContent = "Referral code copied!";
    } catch (error) {
        message.textContent = "Your referral code is: " + code;
    }
});
</script>

</body>
</html>
